rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.language is string && (data.language == 'en' || data.language == 'hi' || data.language == 'mr')
        && data.level is string && (data.level == 'beginner' || data.level == 'standard' || data.level == 'pro')
        && (!('email' in data) || (data.email is string && data.email.size() <= 256))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512))
        && (!('points' in data) || data.points is number)
        && (!('completedTips' in data) || (data.completedTips is list && data.completedTips.size() <= 200))
        && (!('struggles' in data) || (data.struggles is list && data.struggles.size() <= 100));
    }

    // User Profile Collection
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Users can only access their own document directly

      allow create: if isOwner(userId)
        && isValidId(userId)
        && incoming().uid == request.auth.uid
        && incoming().keys().hasAll(['uid', 'language', 'level'])
        && incoming().keys().hasOnly(['uid', 'language', 'level', 'email', 'displayName', 'photoURL', 'points', 'completedTips', 'struggles', 'createdAt', 'updatedAt'])
        && isValidUser(incoming());

      allow update: if isOwner(userId)
        && isValidId(userId)
        && incoming().uid == existing().uid
        && isValidUser(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['language', 'level', 'email', 'displayName', 'photoURL', 'points', 'completedTips', 'struggles', 'updatedAt']);

      allow delete: if false;
    }
  }
}
